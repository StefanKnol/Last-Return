{
  "name": "game-last-return",
  "version": "1.40.0",
  "private": true,
  "license": "MIT",
  "description": "Last Return: a first-person horror game where a handheld LiDAR scanner is the only way to see.",
  "scripts": {
    "build": "node build.js && node --check build/bundle.js",
    "build:dev": "node build.js --dev && node --check build/bundle.js && node --check build/workshop-bundle.js",
    "dev": "node tools/dev-server.js",
    "start": "node server/server.js",
    "test": "npm run build:dev && node tools/run-tests.js",
    "screenshots": "npm run build:dev && node tools/take-screenshots.js",
    "audio-check": "npm run build:dev && node tools/audio-check.js",
    "voice-script": "node tools/write-voice-script.js",
    "deploy": "./deploy.sh"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  },
  "dependencies": {
    "ws": "8.23.0"
  }
}
